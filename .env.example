# --- Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Check AI Studio for which models your free tier currently includes.
GEMINI_MODEL=gemini-2.5-flash
# Requests per minute to stay under on the free tier (client-side throttle).
GEMINI_RPM=8

# --- GitHub App (only needed for the webhook server, not the CLI) ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Either paste the PEM with literal \n sequences, or point to the .pem file.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
