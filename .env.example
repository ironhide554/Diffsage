# --- Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Check AI Studio for which models your free tier currently includes.
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per minute to stay under (client-side throttle). The default model allows 15 on the
# free tier; use 4 for models limited to 5 (gemini-2.5-flash, gemini-3.x-flash).
GEMINI_RPM=12

# --- GitHub App (only needed for the webhook server, not the CLI) ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Either paste the PEM with literal \n sequences, or point to the .pem file.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
